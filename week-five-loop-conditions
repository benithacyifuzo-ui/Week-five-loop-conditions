//Project 1--Grade report

const students = [
  { name: "Aline", score: 91 },
  { name: "Eric", score: 47 },
  { name: "Grace", score: 76 },
  { name: "Jean", score: 58 },
  { name: "Diane", score: 83 },
];

let total = 0;
let passed = 0;
let best = students[0];

for (const s of students) {
  let grade;
  if (s.score >= 80) grade = "A";
  else if (s.score >= 70) grade = "B";
  else if (s.score >= 60) grade = "C";
  else if (s.score >= 50) grade = "D";
  else grade = "F";

  if (s.score >= 50) passed++;
  if (s.score > best.score) best = s;
  total += s.score;

  console.log(`${s.name.padEnd(6)} ${s.score}  ${grade}`);
}

const average = total / students.length;
console.log("-------------------");
console.log(`Average: ${average.toFixed(1)}`);
console.log(`Passed: ${passed}/${students.length}`);
console.log(`Top student: ${best.name} (${best.score})`);

// Project two : Number Guessing game

const prompt = require("prompt-sync")();
const secret = Math.floor(Math.random() * 20) + 1;
const maxAttempts = 5;
let attempts = 0;
let won = false;

while (attempts < maxAttempts) {
  const guess = Number(
    prompt(`Guess a number 1-20 (${maxAttempts - attempts} tries left): `),
  );

  // 1. Check if it's a valid number BEFORE counting it as an attempt
  if (Number.isNaN(guess) || guess < 1 || guess > 20) {
    console.log("Please enter a valid number between 1 and 20.");
    continue;
  }

  attempts++; // Only counts valid guesses

  if (guess === secret) {
    won = true;
    break;
  }

  console.log(guess < secret ? "Too low!" : "Too high!");
}

// 2. Fixed the ternary operator syntax here
console.log(
  won
    ? `You won in ${attempts} attempts!`
    : `Game over. The number was ${secret}.`,
);
